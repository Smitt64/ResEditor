/*
Стили выпадающих меню ленты (SARibbon) — синий порт блока QMenu
из FmtLib theme-office2013-green.qss (#217346 -> #0072C6).

Применяется через setStyleSheet() на SARibbonBar главного окна, а не на
само главное окно: stylesheet распространяется по parent-цепочке QObject,
поэтому офисный вид получают только меню, родитель которых находится
внутри ленты (quickAccessBar, SARibbonPannel и т.п.). Превью меню в
редакторе (EditorMenuBar внутри MDI-окна редактора) в эту цепочку не
входит и продолжает рисоваться базовым стилем (windowsvista), как
настоящий рантайм.

Правила с image: для indicator (Checkmark.svg/Radio*.svg) из FmtLib
пропущены — этих ресурсов нет в нашей сборке SARibbon, галочки рисует
базовый стиль.
*/

/* Базовый стиль для всех контекстных меню */
QMenu {
    background-color: #ffffff;
    border: 1px solid #c5d2e0;
    color: #333333;
    font-family: 'Segoe UI';
    font-size: 9pt;
    padding: 1px 0px;
    margin: 0px;
}

/* Элементы меню */
QMenu::item {
    background-color: transparent;
    color: #333333;
    padding: 4px 25px 4px 25px;
    margin: 0px 1px;
    border: 1px solid transparent;
    min-height: 20px;
    font-weight: normal;
}

/* Элемент меню с иконкой - специальные отступы */
QMenu::item:has-icon {
    padding-left: 28px;
}

/* Элемент меню по умолчанию - ЖИРНЫЙ ШРИФТ */
QMenu::item[default="true"] {
    font-weight: bold;
    color: #0072C6;
}

/* Элемент меню при наведении */
QMenu::item:selected {
    background-color: #DEEBF7;
    color: #000000;
    border: 1px solid #BDD7EE;
}

/* Элемент меню по умолчанию при наведении */
QMenu::item[default="true"]:selected {
    font-weight: bold;
    color: #005A9E;
    background-color: #DEEBF7;
}

/* Элемент меню с включенным состоянием */
QMenu::item:enabled {
    color: #333333;
}

/* Элемент меню с отключенным состоянием */
QMenu::item:disabled {
    color: #b2b2b2;
    background-color: transparent;
    font-weight: normal;
}

/* Элемент меню с отключенным состоянием и по умолчанию */
QMenu::item[default="true"]:disabled {
    color: #8FA6BC;
    font-weight: normal;
}

/* Стиль для иконки в меню */
QMenu::icon {
    position: absolute;
    left: 4px;
    width: 16px;
    height: 16px;
}

/* Элемент меню с галочкой (checked) */
QMenu::item:checked {
    background-color: #E5F1FB;
    border: 1px solid #BDD7EE;
}

/* Стиль для разделителя в меню */
QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 3px 10px;
}

/* Подменю (меню второго уровня) */
QMenu::indicator {
    width: 16px;
    height: 16px;
}

/* Стрелка подменю - позиционируем справа
   (ArrowRight.png из FmtLib у нас нет, ArrowMore.png - в ресурсах SARibbon) */
QMenu::right-arrow {
    image: url(:/SARibbon/image/resource/ArrowMore.png);
    width: 8px;
    height: 8px;
    margin-right: 5px;
}

/* Специальные стили для иконок в меню */
QMenu::item:has-icon:checked {
    padding-left: 28px;
}

/* Стили для подменю */
QMenu QMenu {
    background-color: #ffffff;
    border: 1px solid #c5d2e0;
    margin-left: 1px;
}

/* Стиль для заголовка меню (например, в каскадных меню) */
QMenu::title {
    background-color: #f0f0f0;
    color: #666666;
    padding: 4px 10px;
    font-weight: bold;
    border-bottom: 1px solid #e0e0e0;
}

/* Стиль для акселераторов (горячих клавиш) в меню */
QMenu::item:selected QLabel {
    color: #000000;
}

QMenu::item:!selected QLabel {
    color: #666666;
}

/* Элемент меню по умолчанию - акселератор */
QMenu::item[default="true"] QLabel {
    color: #0072C6;
    font-weight: bold;
}

QMenu::item[default="true"]:selected QLabel {
    color: #005A9E;
}

QMenu::item:default {
    font-weight: bold;
}

/* Стиль для меню в панелях инструментов */
QToolBar > QMenu {
    border: 1px solid #c5d2e0;
    margin-top: 2px;
}

/* Стиль для меню в QComboBox */
QComboBox QMenu {
    min-width: 180px;
}

/* Стиль для меню в QPushButton */
QPushButton::menu-indicator {
    width: 14px;
    height: 14px;
    subcontrol-position: right center;
}
